#================================================================================
# Hi3519AV100 Endoscope UI - Cross-Compilation Makefile
#================================================================================
# Target Platform: Hi3519AV100 (ARM Cortex-A53)
# Cross-Compiler: arm-himix200-linux-gcc
# MPP SDK: Hi3519AV100_SDK_V2.0.2.0
# 
# This Makefile cross-compiles LVGL and the endoscope UI for the Hi3519AV100
# platform, linking against Hisilicon MPP libraries (libmpi, libhifb, etc.)
#================================================================================

SHELL := /bin/bash

#--------------------------------------------------------------------------------
# Cross-Compilation Toolchain Configuration
#--------------------------------------------------------------------------------
# Toolchain base directory - modify if your toolchain is in a different location
TOOLCHAIN_BASE    := /opt/hisi-linux/x86-arm/arm-himix200-linux
TOOLCHAIN_BIN     := $(TOOLCHAIN_BASE)/bin

# Cross-compilation prefix
CROSS_COMPILE     := arm-himix200-linux-

# Toolchain commands
CC                := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)gcc
CXX               := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)g++
AR                := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)ar
RANLIB            := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)ranlib
STRIP             := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)strip
OBJCOPY           := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)objcopy
OBJDUMP           := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)objdump
SIZE              := $(TOOLCHAIN_BIN)/$(CROSS_COMPILE)size

#--------------------------------------------------------------------------------
# Hi3519AV100 MPP SDK Configuration
#--------------------------------------------------------------------------------
# MPP SDK paths - modify these if your SDK is in a different location
MPP_SDK_ROOT      := /home/ydy/Hi3519AV100_SDK_V2.0.2.0/smp/a53_linux/mpp
MPP_INC           := $(MPP_SDK_ROOT)/include
MPP_LIB           := $(MPP_SDK_ROOT)/lib

#--------------------------------------------------------------------------------
# Project Structure
#--------------------------------------------------------------------------------
# Directory paths (relative to Makefile location)
LVGL_DIR          := ../lvgl
UI_SRC_DIR        := ../main/src/endoscope_ui
PORT_DIR          := hi3519_port
SRC_DIR           := src
OBJ_DIR           := obj
BIN_DIR           := bin

#--------------------------------------------------------------------------------
# Target Configuration
#--------------------------------------------------------------------------------
TARGET            := endoscope_ui
TARGET_ELF        := $(BIN_DIR)/$(TARGET)

#--------------------------------------------------------------------------------
# ARM Cortex-A53 Compiler Flags
#--------------------------------------------------------------------------------
# Architecture-specific flags for Hi3519AV100 (Cortex-A53)
# Note: arm-himix200-linux-gcc is 32-bit toolchain, use aapcs-linux ABI
ARCH_FLAGS        := -mcpu=cortex-a53 \
                     -mfloat-abi=hard \
                     -mfpu=neon-vfpv4 \
                     -mabi=aapcs-linux

# Optimization and debugging flags
OPT_FLAGS         := -O2 -g

# Warning flags
WARN_FLAGS        := -Wall -Wextra -Wshadow -Wundef \
                     -Wmaybe-uninitialized -Wmissing-prototypes \
                     -Wno-discarded-qualifiers \
                     -Wno-unused-function

# Preprocessor flags
DEFINES           := -DLV_CONF_INCLUDE_SIMPLE \
                     -DLV_LVGL_H_INCLUDE_SIMPLE

#--------------------------------------------------------------------------------
# Include Paths
#--------------------------------------------------------------------------------
# Collect all include directories
INCLUDES          := -I. \
                     -I$(LVGL_DIR) \
                     -I$(LVGL_DIR)/src \
                     -I$(LVGL_DIR)/src/core \
                     -I$(LVGL_DIR)/src/display \
                     -I$(LVGL_DIR)/src/draw \
                     -I$(LVGL_DIR)/src/font \
                     -I$(LVGL_DIR)/src/indev \
                     -I$(LVGL_DIR)/src/layouts \
                     -I$(LVGL_DIR)/src/libs \
                     -I$(LVGL_DIR)/src/misc \
                     -I$(LVGL_DIR)/src/osal \
                     -I$(LVGL_DIR)/src/others \
                     -I$(LVGL_DIR)/src/stdlib \
                     -I$(LVGL_DIR)/src/themes \
                     -I$(LVGL_DIR)/src/tick \
                     -I$(LVGL_DIR)/src/widgets \
                     -I$(LVGL_DIR)/demos \
                     -I$(LVGL_DIR)/examples \
                     -I$(PORT_DIR) \
                     -I$(SRC_DIR) \
                     -I$(MPP_INC)

#--------------------------------------------------------------------------------
# C Flags
#--------------------------------------------------------------------------------
CFLAGS            := $(ARCH_FLAGS) $(OPT_FLAGS) $(WARN_FLAGS) $(DEFINES) $(INCLUDES) \
                     -std=gnu99 \
                     -fdata-sections -ffunction-sections \
                     -fPIC \
                     -D_GNU_SOURCE

#--------------------------------------------------------------------------------
# C++ Flags
#--------------------------------------------------------------------------------
CXXFLAGS          := $(ARCH_FLAGS) $(OPT_FLAGS) $(WARN_FLAGS) $(DEFINES) $(INCLUDES) \
                     -std=gnu++17 \
                     -fdata-sections -ffunction-sections \
                     -fno-rtti -fno-exceptions \
                     -fPIC

#--------------------------------------------------------------------------------
# Linker Flags
#--------------------------------------------------------------------------------
# Library search paths
LDFLAGS           := -L$(MPP_LIB) \
                     -Wl,-rpath-link,$(MPP_LIB)

# Link against required libraries
# Note: Order matters! Libraries that depend on others must come first
LDLIBS            := -lmpi \
                     -lhifb \
                     -lsecurec \
                     -lpthread \
                     -lm \
                     -ldl \
                     -lrt

# Linker optimization flags
LDFLAGS           += -Wl,--gc-sections \
                     -Wl,-Map,$(BIN_DIR)/$(TARGET).map

#--------------------------------------------------------------------------------
# Source Files Collection
#--------------------------------------------------------------------------------
# 1. LVGL Core Sources
LVGL_SRC_C        := $(shell find $(LVGL_DIR)/src -name "*.c" -type f 2>/dev/null)

# 2. LVGL Demos (optional, can be disabled for smaller binary)
LVGL_DEMOS_C      := $(shell find $(LVGL_DIR)/demos -name "*.c" -type f 2>/dev/null)

# 3. LVGL Examples (optional, can be disabled for smaller binary)
LVGL_EXAMPLES_C   := $(shell find $(LVGL_DIR)/examples -name "*.c" -type f 2>/dev/null)

# 4. UI Application Sources
UI_SRC_C          := $(shell find $(UI_SRC_DIR) -name "*.c" -type f 2>/dev/null)

# 5. Port-specific Sources (display/input drivers for Hi3519)
PORT_SRC_C        := $(shell find $(PORT_DIR) -name "*.c" -type f 2>/dev/null)

# 6. Local Source Files
LOCAL_SRC_C       := $(shell find $(SRC_DIR) -name "*.c" -type f 2>/dev/null)
LOCAL_SRC_CPP     := $(shell find $(SRC_DIR) -name "*.cpp" -type f 2>/dev/null)

# Combine all sources
ALL_C_SOURCES     := $(LVGL_SRC_C) $(LVGL_DEMOS_C) $(LVGL_EXAMPLES_C) \
                     $(UI_SRC_C) $(PORT_SRC_C) $(LOCAL_SRC_C)
ALL_CPP_SOURCES   := $(LOCAL_SRC_CPP)

#--------------------------------------------------------------------------------
# Object Files Generation
#--------------------------------------------------------------------------------
# Convert source paths to object paths in obj/
# We use a recursive approach to handle the nested directory structure

# Function to convert source path to object path
# Removes the leading path component and adds obj/ prefix
define source_to_object
$(OBJ_DIR)/$(subst /,_,$(subst ../,,$(subst $(LVGL_DIR)/,,$(1:.c=.o))))
endef

# Generate object file names from source files
OBJS_C            := $(foreach src,$(ALL_C_SOURCES),$(call source_to_object,$(src)))
OBJS_CPP          := $(patsubst $(SRC_DIR)/%.cpp,$(OBJ_DIR)/src_%.o,$(ALL_CPP_SOURCES))
OBJS              := $(OBJS_C) $(OBJS_CPP)

#--------------------------------------------------------------------------------
# Dependency Files
#--------------------------------------------------------------------------------
DEPS              := $(OBJS:.o=.d)

# Include dependency files if they exist
-include $(DEPS)

#--------------------------------------------------------------------------------
# Phony Targets
#--------------------------------------------------------------------------------
.PHONY: all clean info directories strip deploy help check-env

#--------------------------------------------------------------------------------
# Default Target
#--------------------------------------------------------------------------------
all: directories $(TARGET_ELF)
	@echo "============================================================"
	@echo "Build complete: $(TARGET_ELF)"
	@echo "============================================================"

#--------------------------------------------------------------------------------
# Directory Creation
#--------------------------------------------------------------------------------
directories:
	@mkdir -p $(OBJ_DIR) $(BIN_DIR)
	@echo "Created build directories: $(OBJ_DIR), $(BIN_DIR)"

#--------------------------------------------------------------------------------
# Main Target Linking
#--------------------------------------------------------------------------------
$(TARGET_ELF): $(OBJS)
	@echo "Linking $@..."
	$(CC) $(ARCH_FLAGS) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)
	@echo "Binary size:"
	$(SIZE) $@

#--------------------------------------------------------------------------------
# LVGL Source Compilation Rules
#--------------------------------------------------------------------------------
# Pattern rules for compiling LVGL sources

# Core sources
$(OBJ_DIR)/src_core_%.o: $(LVGL_DIR)/src/core/%.c
	@mkdir -p $(@D)
	@echo "CC $<"
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

$(OBJ_DIR)/src_display_%.o: $(LVGL_DIR)/src/display/%.c
