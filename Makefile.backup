#--------------------------------------------------------------------------------
# Utility Targets
#--------------------------------------------------------------------------------
# Strip debug symbols from binary
strip: $(TARGET_ELF)
	@echo "Stripping debug symbols from $(TARGET_ELF)..."
	$(STRIP) $(TARGET_ELF)
	@echo "Stripped binary size:"
	$(SIZE) $(TARGET_ELF)

# Display build information
info:
	@echo "============================================================"
	@echo "Hi3519AV100 Endoscope UI Build Information"
	@echo "============================================================"
	@echo "Cross-compiler: $(CC)"
	@echo "C Compiler version:"
	@$(CC) --version | head -1
	@echo ""
	@echo "Target: $(TARGET_ELF)"
	@echo "Object directory: $(OBJ_DIR)"
	@echo "Binary directory: $(BIN_DIR)"
	@echo ""
	@echo "MPP SDK: $(MPP_SDK_ROOT)"
	@echo "MPP include: $(MPP_INC)"
	@echo "MPP lib: $(MPP_LIB)"
	@echo ""
	@echo "Source files:"
	@echo "  LVGL core: $(words $(LVGL_SRC_C))"
	@echo "  LVGL demos: $(words $(LVGL_DEMOS_C))"
	@echo "  LVGL examples: $(words $(LVGL_EXAMPLES_C))"
	@echo "  UI app: $(words $(UI_SRC_C))"
	@echo "  Port drivers: $(words $(PORT_SRC_C))"
	@echo "  Local: $(words $(LOCAL_SRC_C))"
	@echo "  Total C: $(words $(ALL_C_SOURCES))"
	@echo "  Total C++: $(words $(ALL_CPP_SOURCES))"
	@echo "============================================================"

# Check build environment
check-env:
	@echo "Checking build environment..."
	@echo ""
	@echo "1. Checking cross-compiler..."
	@if [ -x "$(CC)" ]; then \
		echo "   [OK] $(CC)"; \
	else \
		echo "   [FAIL] $(CC) not found"; \
		exit 1; \
	fi
	@echo ""
	@echo "2. Checking MPP SDK..."
	@if [ -d "$(MPP_INC)" ]; then \
		echo "   [OK] MPP include: $(MPP_INC)"; \
	else \
		echo "   [FAIL] MPP include not found"; \
		exit 1; \
	fi
	@if [ -d "$(MPP_LIB)" ]; then \
		echo "   [OK] MPP lib: $(MPP_LIB)"; \
	else \
		echo "   [FAIL] MPP lib not found"; \
		exit 1; \
	fi
	@echo ""
	@echo "3. Checking MPP libraries..."
	@for lib in mpi hifb securec; do \
		if [ -f "$(MPP_LIB)/lib$$lib.so" ] || [ -f "$(MPP_LIB)/lib$$lib.a" ]; then \
			echo "   [OK] lib$$lib found"; \
		else \
			echo "   [WARN] lib$$lib not found (may be linked dynamically)"; \
		fi; \
	done
	@echo ""
	@echo "4. Checking LVGL..."
	@if [ -d "$(LVGL_DIR)" ]; then \
		echo "   [OK] LVGL directory: $(LVGL_DIR)"; \
	else \
		echo "   [FAIL] LVGL not found at $(LVGL_DIR)"; \
		exit 1; \
	fi
	@echo ""
	@echo "Environment check complete!"

# Deploy target (calls deploy.sh)
deploy: $(TARGET_ELF)
	@echo "Deploying to target..."
	@if [ -x "./deploy.sh" ]; then \
		./deploy.sh; \
	else \
		echo "[ERROR] deploy.sh not found or not executable"; \
		echo "Create deploy.sh with your target configuration"; \
		exit 1; \
	fi

#--------------------------------------------------------------------------------
# Clean Target
#--------------------------------------------------------------------------------
clean:
	@echo "Cleaning build artifacts..."
	@rm -rf $(OBJ_DIR) $(BIN_DIR)
	@echo "Clean complete."

#--------------------------------------------------------------------------------
# Help Target
#--------------------------------------------------------------------------------
help:
	@echo "Hi3519AV100 Endoscope UI - Cross-Compilation Makefile"
	@echo ""
	@echo "Usage: make [target]"
	@echo ""
	@echo "Targets:"
	@echo "  all         - Build the endoscope_ui binary (default)"
	@echo "  clean       - Remove all build artifacts"
	@echo "  strip       - Strip debug symbols from binary"
	@echo "  info        - Display build configuration information"
	@echo "  check-env   - Verify build environment (toolchain, SDK, etc.)"
	@echo "  deploy      - Deploy binary to target (requires deploy.sh)"
	@echo "  help        - Display this help message"
	@echo ""
	@echo "Configuration:"
	@echo "  Edit this Makefile to adjust:"
	@echo "    - TOOLCHAIN_BASE: Cross-compiler location"
	@echo "    - MPP_SDK_ROOT:   Hi3519 MPP SDK location"
	@echo "    - OPT_FLAGS:      Optimization level (-O0, -O1, -O2, -Os)"
	@echo ""
	@echo "Example:"
	@echo "  make check-env    # Verify your setup"
	@echo "  make -j4          # Build with 4 parallel jobs"
	@echo "  make strip        # Create stripped binary"
	@echo "  make deploy       # Deploy to target board"

#================================================================================
# End of Makefile
#================================================================================
